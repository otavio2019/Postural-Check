generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatusAnalise {
  IMAGENS_ARMAZENADAS
  PROCESSANDO
  CONCLUIDA
  ERRO
}

model Analise {
  id          String  @id @default(cuid())
  nome        String  @db.VarChar(100)
  idade       Int
  observacoes String? @db.VarChar(500)

  imagemFrentePath  String @db.VarChar(255)
  imagemLateralPath String @db.VarChar(255)
  imagemCostasPath  String @db.VarChar(255)

  status    StatusAnalise @default(IMAGENS_ARMAZENADAS)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("analises")
}
